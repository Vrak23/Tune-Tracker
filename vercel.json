{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/callback",
      "destination": "/index.html"
    },
    {
      "source": "/tops",
      "destination": "/public/index.html"
    },
    {
      "source": "/analisis",
      "destination": "/public/index.html"
    },
    {
      "source": "/curador",
      "destination": "/public/index.html"
    },
    {
      "source": "/progreso",
      "destination": "/public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
